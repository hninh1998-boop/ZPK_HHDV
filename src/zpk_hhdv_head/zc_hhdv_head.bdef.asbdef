projection;
strict ( 2 );
use draft;

define behavior for zc_hhdv_head alias HHDVHead
{
  use create;
  use update;
  use delete;

  use action LayDuLieu;
  use action UdtReturnInv;
  use action UdtInvoiceStatus;

  use action Activate;
  use action Discard;
  use action Edit;
  use action Resume;
  use action Prepare;

  use association _Item { create; with draft; }
}

define behavior for zc_hhdv_item alias HHDVItem
{
  use update;
  use delete;

  use association _Head { with draft; }
}